{
  "name": "witchery",
  "version": "0.1.0",
  "private": true,
  "description": "Co-op open-world paintbrush adventure built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite \"node server/server.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/server.js",
    "serve": "npm run build && node server/server.js"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^8.0.0"
  }
}
