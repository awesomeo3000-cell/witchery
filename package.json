{
  "name": "witchery",
  "version": "0.1.0",
  "private": true,
  "description": "Co-op open-world paintbrush adventure built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite \"node server/server.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/server.js",
    "serve": "npm run build && node server/server.js",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "smoke": "node test/smoke/smoke.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "playwright": "^1.56.1",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
